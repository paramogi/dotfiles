+static struct fcft_font *
+font_for_scale(uint32_t s)
+{
+	if (!fonts[s]) {
+		char buf[16];
+		snprintf(buf, sizeof buf, "dpi=%u", 96 * s);
+		if (!(fonts[s] = fcft_from_name(1, (const char *[]) {fontstr}, buf)))
+			DIE("Could not load font");
+	}
+	return fonts[s];
+}
+
+static void
+bar_set_scale(Bar *bar, uint32_t s)
+{
+	if (s < 1)
+		s = 1;
+	if (s > MAX_SCALE)
+		s = MAX_SCALE;
+	bar->scale = s;
+	bar->font = font_for_scale(s);
+	bar->textpadding = bar->font->height / 2;
+	bar->height = (bar->font->height / s + vertical_padding * 2) * s;
+}
+
+static void
+wl_output_geometry(void *data, struct wl_output *wl_output, int32_t x, int32_t y,
+		   int32_t pw, int32_t ph, int32_t subpixel, const char *make,
+		   const char *model, int32_t transform)
+{
+}
