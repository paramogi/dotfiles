+{
+}
+
+static void
+wl_output_scale(void *data, struct wl_output *wl_output, int32_t factor)
+{
+	Bar *bar = (Bar *)data;
+
+	bar->pending_scale = factor < 1 ? 1 : factor > MAX_SCALE ? MAX_SCALE : factor;
+}
+
+static void
+wl_output_done(void *data, struct wl_output *wl_output)
+{
+	Bar *bar = (Bar *)data;
+
+	if (scale_forced || !bar->pending_scale || bar->pending_scale == bar->scale)
+		return;
+	if (!bar->font) {
+		/* not set up yet, setup_bar picks it up */
+		bar->scale = bar->pending_scale;
+		return;
+	}
+	bar_set_scale(bar, bar->pending_scale);
+	if (!bar->hidden) {
+		hide_bar(bar);
+		show_bar(bar);
+	}
+}
+
+static const struct wl_output_listener wl_output_listener = {
