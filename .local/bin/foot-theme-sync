#!/bin/sh
# Keep foot's color theme in sync with the system dark/light preference.
# color-scheme values from xdg-desktop-portal: 1 = dark, 2 = light, 0 = no preference (treated as light)

STATE="${XDG_CONFIG_HOME:-$HOME/.config}/foot/theme-mode.ini"

apply() {
    case "$1" in
        1) mode=dark;  sig=USR1 ;;
        *) mode=light; sig=USR2 ;;
    esac
    # Starting theme for foot windows opened from now on
    printf 'initial-color-theme=%s\n' "$mode" > "$STATE"
    # Switch running foot windows (including a foot --server)
    pkill -"$sig" -x foot
}

extract() { sed -n 's/.*uint32 \([0-9]\).*/\1/p'; }

# Apply the current setting at startup
apply "$(gdbus call --session \
    --dest org.freedesktop.portal.Desktop \
    --object-path /org/freedesktop/portal/desktop \
    --method org.freedesktop.portal.Settings.Read \
    org.freedesktop.appearance color-scheme | extract)"

# Follow changes
gdbus monitor --session \
    --dest org.freedesktop.portal.Desktop \
    --object-path /org/freedesktop/portal/desktop |
while read -r line; do
    case "$line" in
        *SettingChanged*org.freedesktop.appearance*color-scheme*)
            apply "$(printf '%s\n' "$line" | extract)" ;;
    esac
done
