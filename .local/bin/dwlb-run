#!/bin/sh
mode=${1:-$(sed -n 's/^initial-color-theme=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/foot/theme-mode.ini")}

if [ "$mode" = light ]; then
    set -- \
        -inactive-fg-color '#000000' -inactive-bg-color '#d7d7d7' \
        -occupied-fg-color '#000000' -occupied-bg-color '#d7d7d7' \
        -active-fg-color '#ffffff' -active-bg-color '#000000' \
        -urgent-fg-color '#000000' -urgent-bg-color '#72dec2' \
        -middle-bg-color '#d7d7d7' -middle-bg-color-selected '#000000'
else
    mode=dark
    set -- \
        -inactive-fg-color '#ffffff' -inactive-bg-color '#000000' \
        -occupied-fg-color '#ffffff' -occupied-bg-color '#000000' \
        -active-fg-color '#000000' -active-bg-color '#ffffff' \
        -urgent-fg-color '#000000' -urgent-bg-color '#72dec2' \
        -middle-bg-color '#000000' -middle-bg-color-selected '#ffffff'
fi

echo "$$ $mode" >"$XDG_RUNTIME_DIR/dwlb.state"
dwlb "$@" &
sleep 0.3
slstatus -s | dwlb -status-stdin all &
wait
