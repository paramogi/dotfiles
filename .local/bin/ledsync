#!/bin/sh
# set ThinkPad mute LEDs from PipeWire default sink/source state
led() {
    v=$(wpctl get-volume "$1" 2>/dev/null) || return
    case $v in
    *MUTED*) l=1 ;;
    *) l=0 ;;
    esac
    brightnessctl -q -d "$2" set "$l"
}
led @DEFAULT_AUDIO_SINK@ platform::mute
led @DEFAULT_AUDIO_SOURCE@ platform::micmute
