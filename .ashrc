### source
alias so='source'

### nvim
alias vi='nvim'
alias vim='nvim'

### git clone
alias gcl='git clone'

### git status
alias gs='git status'

### git add
alias ga='git add'
alias gaa='git add --all'

### git commit
alias gc='git commit'
alias gcm='git commit -m'

### git restore
alias grs='git restore --staged'
alias gr='git restore'

### git push pull
alias gp='git push'
alias gpl='git pull'

### git diff
alias gdf='git diff'
alias gdfs='git diff --staged'

### git log
alias gl='git log'
